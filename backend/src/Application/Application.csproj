<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AuthService.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <!--
    Application — здесь будут use-case'ы (сценарии), интерфейсы репозиториев
    и сервисов (например, IHealthCheckRepository, IPasswordHasher), DTO,
    валидация. Application зависит только от Domain — не от Infrastructure
    и не от Api. Реализации интерфейсов кладём в Infrastructure и
    подключаем через DI (Dependency Inversion — суть чистой архитектуры).
  -->

</Project>
