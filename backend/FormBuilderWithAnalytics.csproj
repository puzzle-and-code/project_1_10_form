<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>d77c8e55-4d8b-4c48-bc35-db25fb680a71</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
  </ItemGroup>

  <!--
    Папка src/ рядом — это отдельный, старый скелет (4 своих .csproj:
    Api/Application/Domain/Infrastructure), а не часть этого проекта.
    Без этих исключений SDK-стиль проекта по умолчанию подхватывает
    ВСЕ .cs-файлы из подпапок, включая чужой Program.cs (конфликт
    top-level statements, CS8802) и сгенерированные AssemblyInfo.cs
    из obj/ других проектов (повторяющиеся атрибуты, CS0579).
  -->
  <ItemGroup>
    <Compile Remove="src/**/*.cs" />
    <Content Remove="src/**/*" />
    <None Remove="src/**/*" />
    <EmbeddedResource Remove="src/**/*" />
  </ItemGroup>

</Project>
